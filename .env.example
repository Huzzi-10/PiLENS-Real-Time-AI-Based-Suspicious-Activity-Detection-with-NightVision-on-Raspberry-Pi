# Copy this file to .env and update the values for your own setup.
# Never commit the real .env file.

SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password
RECEIVER_EMAIL=receiver_email@gmail.com

YOLO_MODEL_PATH=Models/yolo11n.pt
CLASSIFIER_MODEL_PATH=Models/action_model.pth

# Optional: use a local video file instead of the Raspberry Pi camera in Program_3.py.
USE_VIDEO=false
VIDEO_PATH=Camera.mp4

# --- PiLENS v2 runtime (python -m pilens_v2.runtime.run) ---
# MJPEG stream: keep 127.0.0.1, or the Pi's Tailscale IP (100.x.y.z). Never a public IP.
STREAM_HOST=127.0.0.1
STREAM_PORT=8000
# Fixed exposure / gain for the NoIR camera (auto-exposure causes flicker)
CAMERA_EXPOSURE_US=20000
CAMERA_GAIN=4.0
LED_PIN=17
BUZZER_PIN=18
